<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Active Extrusion Ledge -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Selected Surface -->
    <item android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/mode_selected_top"
                android:endColor="@color/mode_selected_bottom"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.8dp"
                android:color="@color/mode_selected_border" />
        </shape>
    </item>
</layer-list>
