<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/transcript_out_top"
                android:endColor="@color/transcript_out_bottom"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/transcript_out_border" />
        </shape>
    </item>
</layer-list>
