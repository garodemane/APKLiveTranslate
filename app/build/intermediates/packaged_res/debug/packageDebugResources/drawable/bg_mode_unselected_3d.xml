<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Unselected Extrusion Ledge -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow_ledge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Unselected Surface -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/mode_unselected_top"
                android:endColor="@color/mode_unselected_bottom"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/mode_unselected_border" />
        </shape>
    </item>
</layer-list>
